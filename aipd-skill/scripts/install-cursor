#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/legacy-skills"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
DIST_DIR="$PROJECT_ROOT/dist/cursor/skills"
CURSOR_TARGET_DIR="$HOME/.cursor/skills"
FORBIDDEN_CURSOR_BUILTIN="$HOME/.cursor/skills-cursor"
FORBIDDEN_CODEX_DIR="$HOME/.codex/skills"
FORBIDDEN_DSH_DIR="$HOME/.dsh/skills"

"$SCRIPT_DIR/build" cursor

if [ ! -d "$DIST_DIR" ]; then
    echo "缺少 Cursor 产物: $DIST_DIR" >&2
    exit 1
fi

if [ "$CURSOR_TARGET_DIR" = "$FORBIDDEN_CURSOR_BUILTIN" ] \
    || [ "$CURSOR_TARGET_DIR" = "$FORBIDDEN_CODEX_DIR" ] \
    || [ "$CURSOR_TARGET_DIR" = "$FORBIDDEN_DSH_DIR" ]; then
    echo "拒绝安装到禁止目录: $CURSOR_TARGET_DIR" >&2
    exit 1
fi

mkdir -p "$CURSOR_TARGET_DIR"

for legacy in "${AIPD_LEGACY_SKILLS[@]}"; do
    target="$CURSOR_TARGET_DIR/$legacy"
    if [ -e "$target" ] || [ -L "$target" ]; then
        rm -rf "$target"
        echo "移除旧 skill: $target"
    fi
done

for skill_dir in "$DIST_DIR"/*/; do
    [ -d "$skill_dir" ] || continue
    name=$(basename "$skill_dir")
    target="$CURSOR_TARGET_DIR/$name"
    rm -rf "$target"
    cp -r "$skill_dir" "$target"
    echo "安装 [cursor]: $target"
done

echo ""
echo "Cursor 安装完成。"
echo "skill 已复制到 $CURSOR_TARGET_DIR/"
echo "未写入 $FORBIDDEN_CURSOR_BUILTIN、$FORBIDDEN_CODEX_DIR 或 $FORBIDDEN_DSH_DIR。"
echo "无头执行层使用已登录的 cursor-agent，和桌面端读同一套 skill。"
