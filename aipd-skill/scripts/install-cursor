#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/legacy-skills"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
DIST_DIR="$PROJECT_ROOT/dist/cursor/skills"
CURSOR_TARGET_DIR="$HOME/.cursor/skills"
DSH_TARGET_DIR="$HOME/.dsh/skills"
FORBIDDEN_CURSOR_BUILTIN="$HOME/.cursor/skills-cursor"
FORBIDDEN_CODEX_DIR="$HOME/.codex/skills"

"$SCRIPT_DIR/build" cursor

if [ ! -d "$DIST_DIR" ]; then
    echo "缺少 Cursor 产物: $DIST_DIR" >&2
    exit 1
fi

install_skills_to() {
    local target_dir="$1"
    local label="$2"

    if [ "$target_dir" = "$FORBIDDEN_CURSOR_BUILTIN" ] || [ "$target_dir" = "$FORBIDDEN_CODEX_DIR" ]; then
        echo "拒绝安装到禁止目录: $target_dir" >&2
        exit 1
    fi

    mkdir -p "$target_dir"

    for legacy in "${AIPD_LEGACY_SKILLS[@]}"; do
        local target="$target_dir/$legacy"
        if [ -e "$target" ] || [ -L "$target" ]; then
            rm -rf "$target"
            echo "移除旧 skill: $target"
        fi
    done

    local skill_dir
    for skill_dir in "$DIST_DIR"/*/; do
        [ -d "$skill_dir" ] || continue
        local name target
        name=$(basename "$skill_dir")
        target="$target_dir/$name"
        rm -rf "$target"
        cp -r "$skill_dir" "$target"
        echo "安装 [$label]: $target"
    done
}

echo "提醒：Cursor 与 DSH 绑定使用，本次同时安装到这两个目录。"
echo "  Cursor: $CURSOR_TARGET_DIR"
echo "  DSH:    $DSH_TARGET_DIR"
echo ""

install_skills_to "$CURSOR_TARGET_DIR" "cursor"
install_skills_to "$DSH_TARGET_DIR" "dsh"

echo ""
echo "Cursor + DSH 安装完成。"
echo "skill 已同时复制到 $CURSOR_TARGET_DIR/ 与 $DSH_TARGET_DIR/"
echo "未写入 $FORBIDDEN_CURSOR_BUILTIN 或 $FORBIDDEN_CODEX_DIR。"

WEB_PATCH="$HOME/.dsh/profiles/web/cordis.patch.yml"
if [ -f "$WEB_PATCH" ] && grep -Fq '.codex/skills' "$WEB_PATCH"; then
    echo ""
    echo "注意：本机 DSH web profile 仍桥接 $FORBIDDEN_CODEX_DIR。"
    echo "headless（默认 Case 执行层）会读 $DSH_TARGET_DIR；DSH GUI 若仍只扫 Codex 目录，需要你自己改 $WEB_PATCH。"
fi
