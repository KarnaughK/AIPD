#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
SRC_DIR="$PROJECT_ROOT/src"
DIST_ROOT="$PROJECT_ROOT/dist"

build_platform() {
    local platform="$1"
    local dist_dir="$DIST_ROOT/$platform/skills"
    local agents_src_dir="$SRC_DIR/platforms/$platform/agents"
    local agents_dist_dir="$DIST_ROOT/$platform/agents"
    local platform_core_dir="$SRC_DIR/platforms/$platform/core"
    local skill_count

    rm -rf "$dist_dir"
    mkdir -p "$dist_dir"

    for skill_dir in "$SRC_DIR/skills"/*/; do
        if [ ! -f "$skill_dir/SKILL.md" ]; then
            continue
        fi

        local skill_name
        local dest
        skill_name=$(basename "$skill_dir")
        dest="$dist_dir/$skill_name"

        echo "构建 [$platform] $skill_name ..."
        cp -r "$skill_dir" "$dest"
        mkdir -p "$dest/references"

        if [ "$skill_name" = "aipd" ]; then
            mkdir -p "$dest/scripts"
            cp "$SCRIPT_DIR/migrate-project-schema" "$dest/scripts/migrate-project-schema"
            chmod +x "$dest/scripts/migrate-project-schema"
        fi

        local in_inject=false
        while IFS= read -r line; do
            if [[ "$line" =~ ^inject-from-core: ]]; then
                in_inject=true
                continue
            fi

            if $in_inject; then
                if [[ "$line" =~ ^[[:space:]]*-[[:space:]] ]]; then
                    local src_path
                    src_path=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//')
                    inject_core_path "$platform_core_dir" "$SRC_DIR/core" "$src_path" "$dest/references"
                elif [[ "$line" =~ ^--- ]] || [[ ! "$line" =~ ^[[:space:]] ]]; then
                    in_inject=false
                fi
            fi
        done < "$dest/SKILL.md"

        strip_build_metadata "$dest/SKILL.md"

        echo "  完成 → $dest"
    done

    build_platform_agents "$agents_src_dir" "$agents_dist_dir" "$SRC_DIR/core"

    echo ""
    echo "[$platform] 构建完成。产物在 $dist_dir/"
    skill_count=$(find "$dist_dir" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
    echo "共 $skill_count 个 skill"
    echo ""
}

strip_build_metadata() {
    local skill_file="$1"
    local rendered_file
    rendered_file=$(mktemp "${skill_file}.tmp.XXXXXX")

    render_runtime_skill_file "$skill_file" "$rendered_file"
    cp "$rendered_file" "$skill_file"
    rm -f "$rendered_file"
}

render_runtime_skill_file() {
    local source_file="$1"
    local output_file="$2"
    local line
    local line_number=0
    local line_has_newline
    local in_frontmatter=false
    local skip_inject_list=false
    local keep_line

    while true; do
        line=""
        if IFS= read -r line; then
            line_has_newline=true
        else
            line_has_newline=false
        fi

        if ! $line_has_newline && [ -z "$line" ]; then
            break
        fi

        line_number=$((line_number + 1))
        keep_line=true

        if [ "$line_number" -eq 1 ] && [ "$line" = "---" ]; then
            in_frontmatter=true
        elif $in_frontmatter; then
            if $skip_inject_list; then
                if [[ "$line" =~ ^[[:space:]]+-([[:space:]]|$) ]]; then
                    keep_line=false
                else
                    skip_inject_list=false
                fi
            fi

            if $keep_line; then
                if [[ "$line" =~ ^inject-from-core:[[:space:]]*$ ]]; then
                    keep_line=false
                    skip_inject_list=true
                elif [ "$line" = "---" ]; then
                    in_frontmatter=false
                fi
            fi
        fi

        if $keep_line; then
            if $line_has_newline; then
                printf '%s\n' "$line"
            else
                printf '%s' "$line"
            fi
        fi

        if ! $line_has_newline; then
            break
        fi
    done < "$source_file" > "$output_file"
}

validate_platform() {
    local platform="$1"

    if [[ ! "$platform" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "非法平台名: $platform" >&2
        echo "平台名只能包含字母、数字、点、下划线和连字符，且必须以字母或数字开头。" >&2
        exit 1
    fi
}

build_all_platforms() {
    local platform_dir
    local platform
    local platform_count=0

    rm -rf "$DIST_ROOT"

    for platform_dir in "$SRC_DIR/platforms"/*/; do
        [ -d "$platform_dir" ] || continue
        platform=$(basename "$platform_dir")
        validate_platform "$platform"
        build_platform "$platform"
        platform_count=$((platform_count + 1))
    done

    if [ "$platform_count" -eq 0 ]; then
        echo "src/platforms/ 下没有可构建的平台。" >&2
        exit 1
    fi
}

build_platform_agents() {
    local agents_src_dir="$1"
    local agents_dist_dir="$2"
    local common_core_dir="$3"

    rm -rf "$agents_dist_dir"
    if [ ! -d "$agents_src_dir" ]; then
        return
    fi

    mkdir -p "$agents_dist_dir"

    for agent_file in "$agents_src_dir"/*.toml; do
        [ -e "$agent_file" ] || continue

        local name
        local dest
        local instructions_file
        local instructions_path
        name=$(basename "$agent_file")
        dest="$agents_dist_dir/$name"
        instructions_file=$(sed -n 's/^instructions_file[[:space:]]*=[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$agent_file" | head -1)

        if [ -z "$instructions_file" ]; then
            cp "$agent_file" "$dest"
            continue
        fi

        instructions_path="$common_core_dir/$instructions_file"
        if [ ! -f "$instructions_path" ]; then
            echo "缺少 Agent 指引源文件: $instructions_path"
            exit 1
        fi

        grep -v '^instructions_file[[:space:]]*=' "$agent_file" > "$dest"
        {
            echo 'developer_instructions = """'
            cat "$instructions_path"
            echo '"""'
        } >> "$dest"
    done

    echo "[$platform] Agent 模板完成 → $agents_dist_dir"
}

inject_core_path() {
    local platform_core_dir="$1"
    local common_core_dir="$2"
    local src_path="$3"
    local references_dir="$4"

    if [[ "$src_path" == *"/*" ]]; then
        local dir_path="${src_path%/*}"
        local platform_dir="$platform_core_dir/$dir_path"
        local common_dir="$common_core_dir/$dir_path"

        mkdir -p "$references_dir/$dir_path"
        if [ -d "$common_dir" ]; then
            cp -R "$common_dir"/. "$references_dir/$dir_path/"
        fi
        if [ -d "$platform_dir" ]; then
            cp -R "$platform_dir"/. "$references_dir/$dir_path/"
        fi
        if [ ! -d "$common_dir" ] && [ ! -d "$platform_dir" ]; then
            echo "缺少注入目录: $dir_path" >&2
            exit 1
        fi
    elif [[ "$src_path" == *"/"* ]]; then
        local target_dir
        local platform_file="$platform_core_dir/$src_path"
        local common_file="$common_core_dir/$src_path"
        local source_file
        target_dir=$(dirname "$src_path")

        if [ -f "$platform_file" ]; then
            source_file="$platform_file"
        else
            source_file="$common_file"
        fi

        mkdir -p "$references_dir/$target_dir"
        cp "$source_file" "$references_dir/$target_dir/"
    else
        local platform_file="$platform_core_dir/$src_path"
        local common_file="$common_core_dir/$src_path"
        local source_file

        if [ -f "$platform_file" ]; then
            source_file="$platform_file"
        else
            source_file="$common_file"
        fi

        cp "$source_file" "$references_dir/"
    fi
}

if [ "$#" -eq 0 ]; then
    rm -rf "$DIST_ROOT"
    build_platform "codex"
    exit 0
fi

if [ "$#" -ne 1 ]; then
    echo "用法: aipd-skill/scripts/build [all|<platform>]" >&2
    exit 1
fi

requested_platform="$1"
if [ "$requested_platform" = "all" ]; then
    build_all_platforms
else
    validate_platform "$requested_platform"
    build_platform "$requested_platform"
fi
