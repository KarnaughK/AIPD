  ],
])

const LEGACY_HISTORY_PATHS = Object.freeze([
  `${LEGACY_ROOT}/development-log.md`,
  `${CURRENT_ROOT}/development-log.md`,
])

// Archive files are non-executable historical snapshots. The active c22 Case is
// the migration contract itself; both may describe the legacy schema literally.
const LEGACY_HISTORY_PATH_PREFIXES = Object.freeze([
  `${LEGACY_ROOT}/case/archive/`,
  `${CURRENT_ROOT}/case/archive/`,
  `${LEGACY_ROOT}/case/c22-aipd-knowledge-schema/`,
  `${CURRENT_ROOT}/case/c22-aipd-knowledge-schema/`,
])

const EXCLUDED_TEXT_DIRECTORY_NAMES = new Set([
  '.git',
  '.cache',
  '.next',
  '.nuxt',
