  ['L3 Core', 'Core knowledge domain (`knowledge.core`)'],
  ['L4 Product', 'Product knowledge domain (`knowledge.product`)'],
  ['L5 Dev', 'Engineering knowledge domain (`knowledge.engineering`)'],
  ['L6 Code', 'real project code (outside `_aipd/`)'],
