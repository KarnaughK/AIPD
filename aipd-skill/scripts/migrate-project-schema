  `(^|[^A-Za-z0-9_.-])((?:(?:\\.\\.?)/)+)(${LEGACY_KNOWLEDGE_NAMES.join('|')})(?=$|[^A-Za-z0-9_-])`,
  'gu',
)
const BARE_RELATIVE_KNOWLEDGE_PATH_EXPRESSION = new RegExp(
  `(^|[^A-Za-z0-9_./-])(${LEGACY_KNOWLEDGE_NAMES.join('|')})(?=/)`,
  'gu',
)

const MIGRATION_TOOL_PATHS = new Set([
